# Spring Boot — local overrides, often hold credentials
application-secret*.yml
application-secret*.properties
.env
.env.*

# Claude Code — session transcripts, memory and local agent state.
# Default-deny inside .claude/ so state files added by future versions are ignored
# automatically; shared project config is re-included below. A CLAUDE.md at the repo
# root is documentation and stays tracked.
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/skills/

# Session transcripts are UUID-named .jsonl. Ignore them wherever they land, not just
# under .claude/ — one turned up in the repo root inside a directory named " ".
[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].jsonl

